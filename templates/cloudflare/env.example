# ─────────────────────────────────────────────────────────────────────────
# Cloudflare Environment Variables (.env.example)
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# For Cloudflare Pages: set secrets via `wrangler pages secret put <NAME>`
# ─────────────────────────────────────────────────────────────────────────

# Cloudflare API credentials (for Wrangler CLI)
CF_API_TOKEN=your_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
