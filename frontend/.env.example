# ── Flappy Frontier Frontend Environment ──
# Copy to .env.local for local development.

# Sponsor service URL — enables gas-free ranked mode transactions.
# Omit or leave empty to fall back to player-paid gas.
# Local dev:    VITE_SPONSOR_SERVICE_URL=http://localhost:8787
# Production:   VITE_SPONSOR_SERVICE_URL=https://flappy-frontier-sponsor.<account>.workers.dev
# VITE_SPONSOR_SERVICE_URL=
