# Cloudflare Pages custom headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.suiet.app https://*.sui.io https://*.mystenlabs.com https://flappy-frontier-sponsor.michael-davis-home.workers.dev https://world-api-stillness.live.tech.evefrontier.com; frame-ancestors 'none'
